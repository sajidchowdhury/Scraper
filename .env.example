# =============================================================================
# Google Maps Scraper — environment defaults
# =============================================================================
# Copy this file to ".env" and edit as needed.
#   cp .env.example .env
#
# These values are read by src/config.js. CLI flags override env values.
# See `npm start -- --help` for the full list of CLI flags.
# =============================================================================

# ----- Search defaults (overridden by --query / --location / --max-results) -----
DEFAULT_QUERY=Restaurant
DEFAULT_LOCATION=Toronto
# DEFAULT_MAX_RESULTS=        # empty = scrape all available; otherwise a positive integer

# ----- Browser -----
HEADLESS=false                # true | false
SLOW_MO=200                   # ms delay between Playwright actions (debug aid)
VIEWPORT_WIDTH=1400
VIEWPORT_HEIGHT=900

# ----- Output -----
OUTPUT_DIR=./data             # directory where CSV/JSON outputs are written
# OUTPUT_FILE=                # empty = auto-generated filename; otherwise a path

# ----- Logging -----
# LOG_LEVEL=info              # debug | info | warn | error
