# ---------------------------------------------------------------------------
# gmaps-scraper — environment defaults (Phase 1)
# Copy to `.env` and adjust. CLI args override these.
# ---------------------------------------------------------------------------

# Search defaults (overridden by CLI args --query / --location)
DEFAULT_QUERY=Restaurant
DEFAULT_LOCATION=Toronto
# DEFAULT_MAX_RESULTS=  (leave blank = all available)

# Browser
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1400
VIEWPORT_HEIGHT=900

# Timeouts
GLOBAL_TIMEOUT_MS=300000
NAV_TIMEOUT_MS=60000

# Scroll (Phase 1.3)
SCROLL_TIMEOUT_MS=90000
SCROLL_STALL_THRESHOLD=3
SCROLL_BATCH_DELAY_MS=800
SCROLL_POLL_INTERVAL_MS=500

# Extract (Phase 1.4)
EXTRACT_INTER_BATCH_MS=250
# Per-field extraction rate below this % triggers a WARN log
EXTRACT_FIELD_WARN_THRESHOLD=80

# Detail-page deep scrape (Phase 1.5) — toggleable, default off for speed
# Set to true to open each business's detail panel and fetch:
#   full_hours, popular_times, top_reviews, photos,
#   reservation_url, menu_url, social_profiles
DEEP_SCRAPE=false
# Randomized per-detail delay range (ms) — avoids a metronomic request pattern.
# Phase 1.8 note: cfg.antiblock.detailDelayMinMs/MaxMs override these when set
# (defaults there are 1500/3500 per the anti-block spec).
DEEP_SCRAPE_DELAY_MIN_MS=1500
DEEP_SCRAPE_DELAY_MAX_MS=3500
# Hard timeout per business detail scrape (ms)
DEEP_SCRAPE_TIMEOUT_MS=15000
# Caps for variable-length detail fields
DEEP_SCRAPE_MAX_REVIEWS=5
DEEP_SCRAPE_MAX_PHOTOS=5
# Sample step: scrape every Nth business (1 = all, 5 = QA mode for fast smoke tests)
DEEP_SCRAPE_SAMPLE_STEP=1

# Phase 1.7 — Reliability & crash recovery
# Write a .checkpoint.json every N new records during deep-scrape (default: 10)
CHECKPOINT_INTERVAL=10
# Retry attempts for transient operations — page.goto, selector waits, etc. (default: 3)
MAX_RETRIES=3
# Base backoff in ms; doubles each retry → 1000, 2000, 4000 (default: 1000)
RETRY_BASE_MS=1000

# Phase 1.8 — Minimal anti-block behavior
# Max Google-bound requests per minute (sliding window). If the script goes
# faster, it waits. Set to ~30 for normal residential usage. (default: 30)
MAX_REQUESTS_PER_MIN=30
# Human-like char-by-char typing in the search box (50-150ms jitter per key).
# Set to false to fall back to instant .fill(). (default: true)
HUMAN_TYPING=true
# On CAPTCHA / "unusual traffic" detection, pause + alert the operator instead
# of silently failing. Set to false to skip the pause (still exits with code 3).
# (default: true)
CAPTCHA_PAUSE=true
# How long to pause when a CAPTCHA is detected, in ms (default: 300000 = 5min).
# In --headed mode the operator can solve the CAPTCHA in the browser window.
CAPTCHA_WAIT_MS=300000
# Randomized delay ranges (ms) — replace fixed/metronomic waits so the request
# pattern looks human. Defaults match the Phase 1.8 spec:
#   between scroll actions:  800-2000
#   before pressing Enter:   500-1500
#   between detail visits:   1500-3500
#   per keypress (typing):   50-150
SCROLL_DELAY_MIN_MS=800
SCROLL_DELAY_MAX_MS=2000
PRE_ENTER_DELAY_MIN_MS=500
PRE_ENTER_DELAY_MAX_MS=1500
DETAIL_DELAY_MIN_MS=1500
DETAIL_DELAY_MAX_MS=3500
TYPE_KEY_MIN_MS=50
TYPE_KEY_MAX_MS=150
# (EXTRACT_DELAY_MIN_MS / EXTRACT_DELAY_MAX_MS reserved for future per-business
#  extraction throttling; list extraction is currently a single DOM evaluate.)

# Output
OUTPUT_DIR=./data

# Logging: debug | info | warn | error
LOG_LEVEL=info
