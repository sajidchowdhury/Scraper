# =============================================================================
# Google Maps Scraper — environment defaults
# =============================================================================
# Copy this file to ".env" and edit as needed.
#   cp .env.example .env
#
# These values are read by src/config.js. CLI flags override env values.
# See `npm start -- --help` for the full list of CLI flags.
# =============================================================================

# ----- Search defaults (overridden by --query / --location / --max-results) -----
DEFAULT_QUERY=Restaurant
DEFAULT_LOCATION=Toronto
# DEFAULT_MAX_RESULTS=        # empty = scrape all available; otherwise a positive integer

# ----- Browser -----
HEADLESS=false                # true | false
SLOW_MO=200                   # ms delay between Playwright actions (debug aid)
VIEWPORT_WIDTH=1400
VIEWPORT_HEIGHT=900

# ----- Output -----
OUTPUT_DIR=./data             # directory where CSV/JSON outputs are written
# OUTPUT_FILE=                # empty = auto-generated filename; otherwise a path

# ----- Run lifecycle -----
RUN_TIMEOUT_MS=300000         # global run timeout in ms (default: 5 min).
                              # If exceeded, the browser is force-closed and
                              # the process exits with code 3. Minimum: 5000.

# ----- Pagination / infinite-scroll -----
SCROLL_TIMEOUT_MS=60000       # per-pagination budget in ms (default: 60 s).
                              # The scroll loop gives up after this even if
                              # results haven't been exhausted. Minimum: 5000.
SCROLL_STALL_THRESHOLD=3      # consecutive no-progress scrolls before the loop
                              # declares results exhausted and stops. Minimum: 1.

# ----- Logging -----
# LOG_LEVEL=info              # debug | info | warn | error
