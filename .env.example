# ---------------------------------------------------------------------------
# gmaps-scraper — environment defaults (Phase 1)
# Copy to `.env` and adjust. CLI args override these.
# ---------------------------------------------------------------------------

# Search defaults (overridden by CLI args --query / --location)
DEFAULT_QUERY=Restaurant
DEFAULT_LOCATION=Toronto
# DEFAULT_MAX_RESULTS=  (leave blank = all available)

# Browser
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1400
VIEWPORT_HEIGHT=900

# Timeouts
GLOBAL_TIMEOUT_MS=300000
NAV_TIMEOUT_MS=60000

# Scroll (Phase 1.3)
SCROLL_TIMEOUT_MS=90000
SCROLL_STALL_THRESHOLD=3
SCROLL_BATCH_DELAY_MS=800
SCROLL_POLL_INTERVAL_MS=500

# Extract (Phase 1.4)
EXTRACT_INTER_BATCH_MS=250
# Per-field extraction rate below this % triggers a WARN log
EXTRACT_FIELD_WARN_THRESHOLD=80

# Detail-page deep scrape (Phase 1.5) — toggleable, default off for speed
# Set to true to open each business's detail panel and fetch:
#   full_hours, popular_times, top_reviews, photos,
#   reservation_url, menu_url, social_profiles
DEEP_SCRAPE=false
# Randomized per-detail delay range (ms) — avoids a metronomic request pattern.
# Phase 1.8 note: cfg.antiblock.detailDelayMinMs/MaxMs override these when set
# (defaults there are 1500/3500 per the anti-block spec).
DEEP_SCRAPE_DELAY_MIN_MS=1500
DEEP_SCRAPE_DELAY_MAX_MS=3500
# Hard timeout per business detail scrape (ms)
DEEP_SCRAPE_TIMEOUT_MS=15000
# Caps for variable-length detail fields
DEEP_SCRAPE_MAX_REVIEWS=5
DEEP_SCRAPE_MAX_PHOTOS=5
# Sample step: scrape every Nth business (1 = all, 5 = QA mode for fast smoke tests)
DEEP_SCRAPE_SAMPLE_STEP=1

# Phase 1.7 — Reliability & crash recovery
# Write a .checkpoint.json every N new records during deep-scrape (default: 10)
CHECKPOINT_INTERVAL=10
# Retry attempts for transient operations — page.goto, selector waits, etc. (default: 3)
MAX_RETRIES=3
# Base backoff in ms; doubles each retry → 1000, 2000, 4000 (default: 1000)
RETRY_BASE_MS=1000

# Phase 1.8 — Minimal anti-block behavior
# Max Google-bound requests per minute (sliding window). If the script goes
# faster, it waits. Set to ~30 for normal residential usage. (default: 30)
MAX_REQUESTS_PER_MIN=30
# Human-like char-by-char typing in the search box (50-150ms jitter per key).
# Set to false to fall back to instant .fill(). (default: true)
HUMAN_TYPING=true
# On CAPTCHA / "unusual traffic" detection, pause + alert the operator instead
# of silently failing. Set to false to skip the pause (still exits with code 3).
# (default: true)
CAPTCHA_PAUSE=true
# How long to pause when a CAPTCHA is detected, in ms (default: 300000 = 5min).
# In --headed mode the operator can solve the CAPTCHA in the browser window.
CAPTCHA_WAIT_MS=300000
# Randomized delay ranges (ms) — replace fixed/metronomic waits so the request
# pattern looks human. Defaults match the Phase 1.8 spec:
#   between scroll actions:  800-2000
#   before pressing Enter:   500-1500
#   between detail visits:   1500-3500
#   per keypress (typing):   50-150
SCROLL_DELAY_MIN_MS=800
SCROLL_DELAY_MAX_MS=2000
PRE_ENTER_DELAY_MIN_MS=500
PRE_ENTER_DELAY_MAX_MS=1500
DETAIL_DELAY_MIN_MS=1500
DETAIL_DELAY_MAX_MS=3500
TYPE_KEY_MIN_MS=50
TYPE_KEY_MAX_MS=150
# (EXTRACT_DELAY_MIN_MS / EXTRACT_DELAY_MAX_MS reserved for future per-business
#  extraction throttling; list extraction is currently a single DOM evaluate.)

# Output
OUTPUT_DIR=./data

# Logging: debug | info | warn | error
LOG_LEVEL=info

# ===========================================================================
# Phase 2 — Robustness & Scale (see PHASE2_EXECUTION_PLAN.md)
# All Phase 2 env vars below are OPTIONAL. The scraper runs identically to
# Phase 1 if they are unset. Set them only when using the corresponding
# Phase 2 features (PostgreSQL persistence, Redis queue, proxies, CAPTCHA
# solving, etc.).
# ===========================================================================

# ---- Phase 2.1 — PostgreSQL persistence ----
# Set DATABASE_URL to enable --output db (writes scraped businesses to Postgres
# instead of / in addition to CSV/JSON). Leave unset to keep Phase 1 file-only
# behavior. The URL MUST start with postgresql:// or postgres:// — a SQLite
# file:// URL will be rejected.
DATABASE_URL=postgresql://gmaps:gmaps@localhost:5434/gmaps_scraper
#
# After setting DATABASE_URL, create the schema once:
#   npm run db:migrate
# Then run with --output db (or --output all for CSV + JSON + DB):
#   npm start -- --query "Cafe" --location "Berlin" --output db --yes
#
# Comma-separated output targets: csv,json,db,all (default: csv,json)
# OUTPUT=csv,json

# ---- Phase 2.9 — Redis job queue (BullMQ) ----
# Set REDIS_URL to enable --queue on (persistent job queue for batch
# processing). Leave unset to use in-process dispatch (Phase 2.8).
# REDIS_URL=redis://localhost:6379

# ---- Phase 2.3 — Proxy management & rotation ----
# Path to a file with one proxy per line: host:port or host:port:user:pass
# Leave unset for direct connection (Phase 1 behavior).
# PROXY_LIST_FILE=./proxies.txt
# Provider for dynamic proxy fetching: manual | brightdata | smartproxy | oxylabs
# PROXY_PROVIDER=manual
# API key for the provider (when using brightdata/smartproxy/oxylabs)
# PROXY_API_KEY=
# Rotation strategy: round-robin | random | sticky (default: random)
# PROXY_STRATEGY=random
# Requests per proxy before rotation (default: 1 = rotate every request)
# SESSION_LENGTH=1
# Cooldown for burned proxies in ms (default: 600000 = 10min)
# PROXY_COOLDOWN_MS=600000

# ---- Phase 2.4 — Browser fingerprint randomization ----
# random | fixed | off (default: random). Set to off for Phase 1 behavior.
# FINGERPRINT_PROFILE=random
# Pin a specific fingerprint JSON for debugging (overrides random)
# FIXED_FINGERPRINT=

# ---- Phase 2.5 — Stealth hardening ----
# on | off (default: on). When on, applies playwright-extra stealth patches.
# STEALTH=on

# ---- Phase 2.6 — CAPTCHA auto-solving ----
# Provider: 2captcha | anticaptcha | capsolver | mock | none
# (default: none = Phase 1.8 pause-and-alert behavior)
# CAPTCHA_PROVIDER=none
# API key for the chosen provider (required when provider != none/mock)
# CAPTCHA_API_KEY=
# USD budget cap for CAPTCHA solving per run (default: 5.00)
# CAPTCHA_BUDGET=5.00

# ---- Phase 2.7 — Session & cookie rotation ----
# Requests per browser context before rotation (default: 50)
# SESSION_LENGTH=50
# Max session age in ms (default: 600000 = 10min)
# SESSION_MAX_AGE_MS=600000
# Warmup: on | off — visit Google Search/News before Maps (default: on)
# WARMUP=on
# Warmup duration in ms (default: 10000)
# WARMUP_DURATION_MS=10000
# Account warmup: on | off — log in with aged Google accounts (default: off)
# ACCOUNT_WARMUP=off
# Path to JSON file of [{email, password}] for account warmup (gitignored!)
# ACCOUNTS_FILE=

# ---- Phase 2.8 — Worker pool & concurrency ----
# Number of parallel browser workers (default: 1 = Phase 1 sequential).
# Each worker gets its own proxy + fingerprint + session + rate limiter.
# WORKERS=1
# shared | isolated — isolated = each worker pins its own proxy (default);
# shared = all workers draw from the proxy pool on each task.
# WORKER_PROXY_STRATEGY=isolated
# Retire a worker after this many crashes in a 10-min window (default: 3).
# WORKER_CRASH_LIMIT=3
# How long a blocked worker stays out before revival (ms; default: 300000 = 5min).
# WORKER_COOLDOWN_MS=300000
# Load balancer: round-robin (default) | least-busy.
# WORKER_LOAD_BALANCER=round-robin
# Businesses per detail-task batch (default: 20). With WORKERS>1 + DEEP_SCRAPE=true,
# detail work is split into batches of N and run in parallel across the pool.
# WORKER_DETAIL_BATCH_SIZE=20
# Max re-queues per task across workers (default: = WORKERS). A task is re-tried
# on another worker after a block/crash; fails after this many re-queues.
# WORKER_TASK_RETRIES=

# ---- Phase 2.9 — Job queue & orchestration (BullMQ + Redis) ----
# on | off (default: off = Phase 2.8 in-process dispatch — no Redis required).
# When on, jobs are submitted to a BullMQ-backed Redis queue; a worker pulls
# them off and feeds the pool. This decouples submission from execution:
# batch CLI submits 100 jobs and exits; a worker process drains them over
# hours. Jobs persist in Redis — a process crash resumes the queue on restart.
# QUEUE=off
# Redis connection URL (REQUIRED when QUEUE=on). Default points to a local
# Redis instance (docker-compose up redis).
REDIS_URL=redis://localhost:6380
# Default priority for submitted jobs (1=high, 5=normal, 10=low; default 5).
# BullMQ: lower number = higher priority. Paid client jobs → 1; background
# re-scrape → 10.
# QUEUE_PRIORITY=5
# BullMQ retry attempts per job (default 3). After this many failures the job
# is dead-lettered for manual inspection (queue.deadLetter().list()).
# QUEUE_ATTEMPTS=3
# Worker concurrency — how many jobs the worker pulls off the queue in
# parallel (default 1). Should be <= WORKERS so the pool can absorb the load.
# QUEUE_CONCURRENCY=1

# ---- Phase 2.10 — Memory management & long-run stability ----
# Keep the scraper running 8+ hours without OOM or zombie Chromium processes.
# Periodic browser-context restarts (clears Chrome memory leaks), a memory
# monitor that fires onThreshold when heap crosses a limit, a worker health
# probe that detects stuck/bloated/unresponsive workers, a zombie reaper that
# cleans up orphaned Chromium processes at startup + shutdown, and graceful
# degradation under total-process RSS pressure (pause queue → restart contexts
# → reduce pool size). --endless enables Phase 5 continuous scraping (pulls
# jobs from the queue forever) and an HTTP /health endpoint.
#
# All flags default to OFF-equivalents so a Phase 2.9 run is preserved byte-
# for-byte when no Phase 2.10 flag is set. --contextRestartEvery is the single
# knob most operators should turn on first.

# Force-restart the browser context every N tasks to clear Chrome memory leaks
# (default: 50; 0 = off — preserves Phase 2.7 behavior). Independent of session
# rotation: a context is restarted even if it's nowhere near its session-
# rotation threshold, because the goal is memory reclamation, not anti-block.
# CONTEXT_RESTART_EVERY=50

# Per-worker heap threshold in MB (default: 1024). When the memory monitor
# polls process.memoryUsage().heapUsed and it crosses this, the onThreshold
# callback fires (which restarts the current browser context). The default
# matches the execution plan's acceptance criterion (heap stays below 1GB
# per worker in a 4-hour run).
# MAX_HEAP_MB=1024

# Per-worker heap threshold for the worker probe (default: 500). When a
# worker's heap crosses this, the probe fires onIssue({ type: 'heap' }) and
# the caller force-restarts that worker's context. Lower than MAX_HEAP_MB
# because the probe is per-worker (the monitor is process-wide).
# WORKER_MAX_HEAP_MB=500

# Total process RSS threshold in MB (default: 4096). When RSS crosses this,
# graceful degradation runs: pause the queue, wait for in-flight tasks,
# restart every worker's context, run global.gc() (if --expose-gc), resume
# the queue. If RSS is STILL above threshold after restart → reduce pool
# size by 1 worker and log a warning.
# MAX_RSS_MB=4096

# Memory monitor poll cadence in ms (default: 30000 = 30s). The monitor logs
# a snapshot every 5 min (MEMORY_LOG_EVERY_MS) and tracks the all-time
# high-water mark.
# HEALTH_CHECK_INTERVAL_MS=30000
# MEMORY_LOG_EVERY_MS=300000

# Worker probe cadence in ms (default: 60000 = 60s). The probe inspects every
# worker + pings its page with page.evaluate(() => 1) to detect unresponsive
# browsers. Three consecutive timeouts (WORKER_PROBE_THRESHOLD) → unresponsive.
# WORKER_PROBE_INTERVAL_MS=60000
# WORKER_PROBE_TIMEOUT_MS=5000
# WORKER_PROBE_THRESHOLD=3
# A worker is "stuck" if it's busy for this many ms with no task completion
# (default: 600000 = 10 min). Idle workers are NOT stuck.
# WORKER_STUCK_AFTER_MS=600000

# Endless mode (default: off). When on, the scraper never exits — it keeps
# pulling jobs from the BullMQ queue as they arrive (Phase 5 continuous
# scraping). Requires QUEUE=on. Implies an aggressive memory monitor + hourly
# zombie reaper + auto-enabled HTTP /health endpoint.
# ENDLESS=off

# HTTP /health endpoint (default: off; auto-on when ENDLESS=on). Binds a tiny
# HTTP server that serves GET /health → JSON snapshot of the scraper's runtime
# state (status, uptime, heap, workers, queueDepth, endless). Use it with a
# load balancer / Kubernetes liveness probe / external monitor. Returns 200
# for ok/degraded, 503 for unhealthy.
# HEALTH_PORT=
# Bind host (default: 127.0.0.1 — NOT exposed externally. Set 0.0.0.0 to expose
# but make sure the port is firewalled — the endpoint exposes runtime stats).
# HEALTH_HOST=127.0.0.1


# ---- Phase 2.11 — Self-healing selectors ----
# The scraper defends against Google Maps DOM changes in three layers:
#   1. Startup health check — loads a fixture, runs extraction, aborts if
#      core fields (name, rating, reviews_count, address) are below 50%.
#   2. First-batch abort — after the first 10 businesses of a real scrape,
#      if core fields are below 50%, aborts with exit code 3.
#   3. Heuristic auto-discovery — when all selectors for a field miss on a
#      card, fall back to pattern matching (phone regex, non-Google <a href>,
#      aria-label containing "stars", etc.). Fills in the field + logs the
#      suggested selector for the operator to add to src/extract.js.
# Plus selector versioning: each selector set has a version + lastVerifiedDate;
# if a set is older than MAX_SELECTOR_AGE days, a warning is logged at startup.

# Run the startup extraction-rate health check (default: on). When on, the
# scraper loads a fixture HTML file, runs extraction, and aborts if core
# fields are below 50% — catching a DOM change before the run wastes time +
# proxy budget. Set to off for emergency runs (same as --skipHealthCheck).
# HEALTH_CHECK=on

# Heuristic field auto-discovery when selectors fail (default: on). When a
# discoverable field (phone, website, rating, reviews_count) is null on a
# card, scan the card DOM for a pattern match. Discovery is a FALLBACK —
# slow and less reliable than a known selector. The intent is to keep
# extraction alive until a human crafts a new selector.
# AUTO_DISCOVER=on

# Write DOM snippets for low-rate fields to data/selector-debug/ (default: on).
# When a field's extraction rate drops below 80%, the first 500 chars of each
# card's innerHTML is written to {field}_{timestamp}.html — gives the
# developer a sample to craft a new selector without re-running the scrape.
# SELECTOR_DEBUG_DUMP=on

# Max selector age in days before a staleness warning is logged at startup
# (default: 30). Bump the version + lastVerifiedDate in src/selectors/version.js
# when you re-verify against a fixture.
# MAX_SELECTOR_AGE=30

# Override the debug-dump directory (default: ./data/selector-debug).
# SELECTOR_DEBUG_DIR=./data/selector-debug

# Path to the HTML fixture used by the startup health check (default:
# tests/fixtures/Cafe_Berlin_feed.html — captured in Phase 2.0). When set,
# the health check loads this fixture instead of the default.
# HEALTH_CHECK_FIXTURE=tests/fixtures/Cafe_Berlin_feed.html

# Skip the startup health check (same as HEALTH_CHECK=off, but as a CLI flag
# for one-off emergency runs without editing .env).
# SKIP_HEALTH_CHECK=false

# ---- Phase 2.12 — Incremental scraping & detail caching ----
# Only re-scrape businesses that have changed since the last scrape. Detail-page
# deep-scrapes are cached for a configurable TTL. The scraper skips businesses
# whose place_id was seen recently with no detected change, dramatically
# reducing runtime and request count on repeat runs (~80% savings).
#
# Requires --output db (freshness is tracked in PostgreSQL via the
# last_list_scraped / last_detail_scraped / change_hash columns added by the
# Phase 2.12 schema migration). Run `npm run db:migrate` after upgrading to
# add these columns to an existing database (the migration is idempotent).
#
# Enable incremental scraping (skip fresh/unchanged businesses) (default: off).
# When on, the run-level pre-flight checks whether the most recent scrape of
# this (query, location) is within LIST_FRESHNESS_DAYS; if so, the browser is
# NOT launched and businesses are loaded straight from the DB (~0 requests,
# <30s runtime). Use --fresh to force a full re-scrape.
# INCREMENTAL=off

# List-view freshness in days (default: 1). A business is "fresh" if its
# last_list_scraped is within this many days. Fresh + change_hash match →
# skip the detail-scrape entirely (reuse cached detail fields). 0 = always
# stale (re-scrape everything); 365 = fresh for a year.
# LIST_FRESHNESS_DAYS=1

# Detail cache TTL in days (default: 7). Detail data (hours, popular times,
# reviews, photos, reservation/menu/social links) is reused if
# last_detail_scraped is within this many days. 0 = always miss (deep-scrape
# everything). Combine with --noDetailCache to force a one-off refresh.
# DETAIL_CACHE_TTL_DAYS=7

# Review-count delta percent that forces a detail re-scrape even when the
# detail cache is fresh (default: 10). A >10% jump in reviews_count suggests
# the reviews/popular-times data has also changed, so the cached detail is
# likely stale. 0 = always force-refresh on any review change; 1000 = never.
# DETAIL_REFRESH_ON_REVIEW_DELTA=10

# Always deep-scrape every business, ignoring the detail cache TTL (default:
# off). Equivalent to DETAIL_CACHE_TTL_DAYS=0 but as a CLI flag for one-off
# refresh runs without editing .env.
# NO_DETAIL_CACHE=false

# Stale-while-revalidate (stub for Phase 5; default: off). When implemented,
# serves stale data immediately but triggers a background re-scrape. For now,
# accepted + logged, behaves like normal incremental mode.
# SWRR=false

# ---- Phase 2.3 — Proxy management & rotation ----
# Path to a proxy list file (one proxy per line). When set, the scraper routes
# all browser traffic through a rotating pool of these proxies. Lines starting
# with # are comments. Accepted formats per line:
#   protocol://[user:pass@]host:port   e.g. http://u:p@1.2.3.4:8080
#   host:port:user:pass                e.g. 1.2.3.4:8080:u:p
#   host:port                           (no auth — public proxy)
# PROXY_LIST_FILE=./proxies.txt

# Rotation strategy: round-robin | random | sticky (default: random)
# PROXY_STRATEGY=random

# Requests per proxy before rotation (sticky strategy only; default: 1 = rotate every request)
# SESSION_LENGTH=1

# Burn cooldown window in ms (default: 600000 = 10 min). Burned proxies are
# benched for this long before re-entering rotation.
# PROXY_COOLDOWN_MS=600000

# Force a direct connection (no proxy) even if PROXY_LIST_FILE is set.
# Useful for quick smoke tests or when the proxy provider is down.
# NO_PROXY=false

# Provider API (informational — actual provider integration is Phase 2.7).
# When set, the pool calls the provider's API to fetch the proxy list at startup.
# Supported values: brightdata | smartproxy | oxylabs
# PROXY_PROVIDER=
# PROXY_PROVIDER_URL=
# PROXY_PROVIDER_TOKEN=

# Override the burn log path (default: data/proxy_burn_log.jsonl)
# PROXY_BURN_LOG=data/proxy_burn_log.jsonl

# ---- Phase 2.4 — Browser fingerprint randomization ----
# Each run gets a coherent fingerprint: UA + platform + viewport + timezone +
# locale + WebGL vendor/renderer + canvas noise + hardwareConcurrency +
# deviceMemory + geolocation. Coherence is enforced (Windows UA → Win32
# platform, de-DE locale → Europe/Berlin|Vienna timezone, etc.) so the
# fingerprint never leaks a detectable mismatch.

# Profile mode: random | fixed | off (default: random)
#   random — generate a fresh coherent profile per run (recommended)
#   fixed  — use the profile supplied via FIXED_FINGERPRINT (for debugging)
#   off    — disable randomization; use Phase 1 behavior (pickUserAgent +
#            cfg.viewport + en-US + America/Toronto)
# FINGERPRINT_PROFILE=random

# Pin a specific fingerprint (requires FINGERPRINT_PROFILE=fixed). JSON object
# with all canonical fields: userAgent, platform, viewport, screen, timezone,
# locale, languages, webglVendor, webglRenderer, canvasNoiseSeed,
# hardwareConcurrency, deviceMemory, geolocation. Coherence is validated; an
# incoherent fixed profile is rejected (treated as 'off' with a warning).
# FIXED_FINGERPRINT=

# Disable fingerprint randomization (alias for FINGERPRINT_PROFILE=off).
# Useful for reproducing a Phase 1 run exactly.
# NO_FINGERPRINT=false

# ---- Phase 2.5 — Stealth hardening ----
# Patches the bot-detection surfaces that fingerprint randomization doesn't
# cover: navigator.webdriver, window.chrome.runtime, navigator.plugins.length,
# navigator.permissions.query, window.outerWidth/Height, Notification.permission,
# navigator.vendor, navigator.maxTouchPoints. Uses playwright-extra +
# puppeteer-extra-plugin-stealth as the foundation, plus a custom init script
# for Maps-specific detection. Complements (not replaces) the Phase 2.4
# fingerprint — a real Chrome user has BOTH a coherent identity AND no
# automation signals.

# Profile mode: on | off (default: on)
#   on  — playwright-extra + stealth plugin + 10 custom init-script patches
#   off — vanilla playwright (Phase 1/2.4 behavior preserved for A/B testing)
# STEALTH=on

# Debug mode: emit console.warn per patch applied + the resulting navigator
# properties. Useful for debugging which patches took effect on a specific
# detection page. Off by default — the warns would pollute the page console
# during real scraping.
# STEALTH_DEBUG=false

# ---- Phase 2.6 — CAPTCHA auto-solving ----
# When Google shows a CAPTCHA (reCAPTCHA v2/v3 or the "unusual traffic"
# interstitial), automatically solve it via a third-party service and resume
# the scrape unattended. If solving is disabled or fails, fall back to the
# Phase 1.8 behavior (pause --captchaWaitMs, alert the operator).
#
# Provider: 2captcha | anticaptcha | capsolver | mock | none (default: none)
#   none        — Phase 1.8 pause-and-alert (no solver, no API cost)
#   mock        — dry-run solver: returns a fake token, no API call. Use for
#                 testing the orchestrator end-to-end without spending money.
#   2captcha    — REST API (in.php + res.php). ~$0.003 / reCAPTCHA v2 solve.
#   anticaptcha — JSON-RPC (createTask + getTaskResult). ~$0.002 / solve.
#   capsolver   — JSON-RPC (createTask + getTaskResult). ~$0.0008 / solve.
# CAPTCHA_PROVIDER=none

# API key for the chosen provider (required for 2captcha/anticaptcha/capsolver;
# ignored for mock/none). Get one from the provider's dashboard.
# CAPTCHA_API_KEY=

# USD spend cap. Once cumulative solver cost reaches this, the orchestrator
# stops solving and falls back to pause-and-alert — it will NOT spend more.
# Default $5.00 (a line-item cost, per the execution plan). Set 0 to allow no
# solves at all (effectively disables auto-solving).
# CAPTCHA_BUDGET=5.00

# Optional secondary solver tried when the primary fails its retry. Must differ
# from CAPTCHA_PROVIDER and cannot be 'none'. Uses the same CAPTCHA_API_KEY.
# CAPTCHA_FALLBACK_PROVIDER=

# ---- Phase 2.7 — session & cookie rotation ----
# Rotate the browser context (cookies + localStorage + session) every N Maps
# requests OR every M ms — whichever comes first. Each new context starts with
# zero cookies (Playwright isolation) and is optionally warmed up (visits
# google.com etc. before Maps) so the session doesn't look like a zero-history
# bot. This distributes traffic across many distinct sessions, making the
# pattern look like many users rather than one long-lived scraper.
#
# NOTE: --sessionMaxRequests is DISTINCT from Phase 2.3's --sessionLength
# (proxy sticky rotation). The two coexist: proxies rotate per request,
# contexts rotate per N requests.

# Max Maps requests per browser context before rotation (default: 50).
# SESSION_MAX_REQUESTS=50

# Max context age in ms before rotation (default: 600000 = 10 minutes).
# SESSION_MAX_AGE_MS=600000

# Warmup: visit benign pages (google.com, etc.) before the first Maps request
# in each new context (default: on). Defeats zero-history-session detection.
# WARMUP=on

# Total warmup time budget in ms (default: 10000).
# WARMUP_DURATION_MS=10000

# Account warmup: opt-in Google account login per session (default: off).
# Logged-in sessions get more data (full review text) + fewer CAPTCHAs.
# WARNING: account-burn risk — use burner/dedicated scraping accounts only,
# never primary accounts. Each account is used max 1 session per day.
# ACCOUNT_WARMUP=off

# Path to a JSON array of {email, password} Google accounts. MUST be gitignored
# + chmod 600. Credentials are never logged (email redacted to prefix***@domain).
# Required when ACCOUNT_WARMUP=on.
# ACCOUNTS_FILE=


