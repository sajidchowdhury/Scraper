# ---------------------------------------------------------------------------
# gmaps-scraper — environment defaults (Phase 1)
# Copy to `.env` and adjust. CLI args override these.
# ---------------------------------------------------------------------------

# Search defaults (overridden by CLI args --query / --location)
DEFAULT_QUERY=Restaurant
DEFAULT_LOCATION=Toronto
# DEFAULT_MAX_RESULTS=  (leave blank = all available)

# Browser
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1400
VIEWPORT_HEIGHT=900

# Timeouts
GLOBAL_TIMEOUT_MS=300000
NAV_TIMEOUT_MS=60000

# Scroll (Phase 1.3)
SCROLL_TIMEOUT_MS=90000
SCROLL_STALL_THRESHOLD=3
SCROLL_BATCH_DELAY_MS=800
SCROLL_POLL_INTERVAL_MS=500

# Extract (Phase 1.4)
EXTRACT_INTER_BATCH_MS=250
# Per-field extraction rate below this % triggers a WARN log
EXTRACT_FIELD_WARN_THRESHOLD=80

# Detail-page deep scrape (Phase 1.5) — toggleable, default off for speed
# Set to true to open each business's detail panel and fetch:
#   full_hours, popular_times, top_reviews, photos,
#   reservation_url, menu_url, social_profiles
DEEP_SCRAPE=false
# Randomized per-detail delay range (ms) — avoids a metronomic request pattern.
# Phase 1.8 note: cfg.antiblock.detailDelayMinMs/MaxMs override these when set
# (defaults there are 1500/3500 per the anti-block spec).
DEEP_SCRAPE_DELAY_MIN_MS=1500
DEEP_SCRAPE_DELAY_MAX_MS=3500
# Hard timeout per business detail scrape (ms)
DEEP_SCRAPE_TIMEOUT_MS=15000
# Caps for variable-length detail fields
DEEP_SCRAPE_MAX_REVIEWS=5
DEEP_SCRAPE_MAX_PHOTOS=5
# Sample step: scrape every Nth business (1 = all, 5 = QA mode for fast smoke tests)
DEEP_SCRAPE_SAMPLE_STEP=1

# Phase 1.7 — Reliability & crash recovery
# Write a .checkpoint.json every N new records during deep-scrape (default: 10)
CHECKPOINT_INTERVAL=10
# Retry attempts for transient operations — page.goto, selector waits, etc. (default: 3)
MAX_RETRIES=3
# Base backoff in ms; doubles each retry → 1000, 2000, 4000 (default: 1000)
RETRY_BASE_MS=1000

# Phase 1.8 — Minimal anti-block behavior
# Max Google-bound requests per minute (sliding window). If the script goes
# faster, it waits. Set to ~30 for normal residential usage. (default: 30)
MAX_REQUESTS_PER_MIN=30
# Human-like char-by-char typing in the search box (50-150ms jitter per key).
# Set to false to fall back to instant .fill(). (default: true)
HUMAN_TYPING=true
# On CAPTCHA / "unusual traffic" detection, pause + alert the operator instead
# of silently failing. Set to false to skip the pause (still exits with code 3).
# (default: true)
CAPTCHA_PAUSE=true
# How long to pause when a CAPTCHA is detected, in ms (default: 300000 = 5min).
# In --headed mode the operator can solve the CAPTCHA in the browser window.
CAPTCHA_WAIT_MS=300000
# Randomized delay ranges (ms) — replace fixed/metronomic waits so the request
# pattern looks human. Defaults match the Phase 1.8 spec:
#   between scroll actions:  800-2000
#   before pressing Enter:   500-1500
#   between detail visits:   1500-3500
#   per keypress (typing):   50-150
SCROLL_DELAY_MIN_MS=800
SCROLL_DELAY_MAX_MS=2000
PRE_ENTER_DELAY_MIN_MS=500
PRE_ENTER_DELAY_MAX_MS=1500
DETAIL_DELAY_MIN_MS=1500
DETAIL_DELAY_MAX_MS=3500
TYPE_KEY_MIN_MS=50
TYPE_KEY_MAX_MS=150
# (EXTRACT_DELAY_MIN_MS / EXTRACT_DELAY_MAX_MS reserved for future per-business
#  extraction throttling; list extraction is currently a single DOM evaluate.)

# Output
OUTPUT_DIR=./data

# Logging: debug | info | warn | error
LOG_LEVEL=info

# ===========================================================================
# Phase 2 — Robustness & Scale (see PHASE2_EXECUTION_PLAN.md)
# All Phase 2 env vars below are OPTIONAL. The scraper runs identically to
# Phase 1 if they are unset. Set them only when using the corresponding
# Phase 2 features (PostgreSQL persistence, Redis queue, proxies, CAPTCHA
# solving, etc.).
# ===========================================================================

# ---- Phase 2.1 — PostgreSQL persistence ----
# Set DATABASE_URL to enable --output db (writes scraped businesses to Postgres
# instead of / in addition to CSV/JSON). Leave unset to keep Phase 1 file-only
# behavior.
# DATABASE_URL=postgresql://gmaps:gmaps@localhost:5432/gmaps_scraper
# Comma-separated output targets: csv,json,db,all (default: csv,json)
# OUTPUT=csv,json

# ---- Phase 2.9 — Redis job queue (BullMQ) ----
# Set REDIS_URL to enable --queue on (persistent job queue for batch
# processing). Leave unset to use in-process dispatch (Phase 2.8).
# REDIS_URL=redis://localhost:6379

# ---- Phase 2.3 — Proxy management & rotation ----
# Path to a file with one proxy per line: host:port or host:port:user:pass
# Leave unset for direct connection (Phase 1 behavior).
# PROXY_LIST_FILE=./proxies.txt
# Provider for dynamic proxy fetching: manual | brightdata | smartproxy | oxylabs
# PROXY_PROVIDER=manual
# API key for the provider (when using brightdata/smartproxy/oxylabs)
# PROXY_API_KEY=
# Rotation strategy: round-robin | random | sticky (default: random)
# PROXY_STRATEGY=random
# Requests per proxy before rotation (default: 1 = rotate every request)
# SESSION_LENGTH=1
# Cooldown for burned proxies in ms (default: 600000 = 10min)
# PROXY_COOLDOWN_MS=600000

# ---- Phase 2.4 — Browser fingerprint randomization ----
# random | fixed | off (default: random). Set to off for Phase 1 behavior.
# FINGERPRINT_PROFILE=random
# Pin a specific fingerprint JSON for debugging (overrides random)
# FIXED_FINGERPRINT=

# ---- Phase 2.5 — Stealth hardening ----
# on | off (default: on). When on, applies playwright-extra stealth patches.
# STEALTH=on

# ---- Phase 2.6 — CAPTCHA auto-solving ----
# Provider: 2captcha | anticaptcha | capsolver | mock | none
# (default: none = Phase 1.8 pause-and-alert behavior)
# CAPTCHA_PROVIDER=none
# API key for the chosen provider (required when provider != none/mock)
# CAPTCHA_API_KEY=
# USD budget cap for CAPTCHA solving per run (default: 5.00)
# CAPTCHA_BUDGET=5.00

# ---- Phase 2.7 — Session & cookie rotation ----
# Requests per browser context before rotation (default: 50)
# SESSION_LENGTH=50
# Max session age in ms (default: 600000 = 10min)
# SESSION_MAX_AGE_MS=600000
# Warmup: on | off — visit Google Search/News before Maps (default: on)
# WARMUP=on
# Warmup duration in ms (default: 10000)
# WARMUP_DURATION_MS=10000
# Account warmup: on | off — log in with aged Google accounts (default: off)
# ACCOUNT_WARMUP=off
# Path to JSON file of [{email, password}] for account warmup (gitignored!)
# ACCOUNTS_FILE=

# ---- Phase 2.8 — Worker pool & concurrency ----
# Number of parallel browser workers (default: 1 = Phase 1 sequential)
# WORKERS=1
# shared | isolated — each worker gets its own proxy (isolated, default)
# WORKER_PROXY_STRATEGY=isolated

# ---- Phase 2.9 — Job queue ----
# on | off (default: off = in-process dispatch)
# QUEUE=off
# Priority for jobs submitted without explicit priority (default: 5)
# QUEUE_PRIORITY=5
# Retry attempts for failed jobs (default: 3)
# QUEUE_ATTEMPTS=3

# ---- Phase 2.10 — Memory management ----
# Restart browser context every N tasks (default: 50)
# CONTEXT_RESTART_EVERY=50
# Max heap per worker in MB before forced context restart (default: 1024)
# MAX_HEAP_MB=1024
# Max total process RSS in MB before graceful degradation (default: 4096)
# MAX_RSS_MB=4096
# Endless mode: keep pulling jobs from the queue indefinitely (default: off)
# ENDLESS=off

# ---- Phase 2.11 — Self-healing selectors ----
# on | off — run startup health check (default: on)
# HEALTH_CHECK=on
# on | off — heuristic field auto-discovery when selectors fail (default: on)
# AUTO_DISCOVER=on
# Max selector age in days before warning (default: 30)
# MAX_SELECTOR_AGE=30

# ---- Phase 2.12 — Incremental scraping & detail caching ----
# Enable incremental scraping (skip fresh/unchanged businesses) (default: off)
# INCREMENTAL=off
# List-view freshness in days (default: 1)
# LIST_FRESHNESS_DAYS=1
# Detail cache TTL in days (default: 7)
# DETAIL_CACHE_TTL_DAYS=7
# Review-count delta % that triggers detail re-scrape (default: 10)
# DETAIL_REFRESH_ON_REVIEW_DELTA=10
