# =============================================================================
# Google Maps Scraper — environment defaults
# =============================================================================
# Copy this file to ".env" and edit as needed.
#   cp .env.example .env
#
# These values are read by src/config.js. CLI argument overrides arrive in
# Phase 1.1 (see PHASE1_EXECUTION_PLAN.md).
# =============================================================================

# ----- Search defaults (overridden by CLI args in Phase 1.1) -----
DEFAULT_QUERY=Restaurant
DEFAULT_LOCATION=Toronto
# DEFAULT_MAX_RESULTS=        # empty = scrape all available results

# ----- Browser -----
HEADLESS=false                # true | false
SLOW_MO=200                   # ms delay between Playwright actions (debug aid)
VIEWPORT_WIDTH=1400
VIEWPORT_HEIGHT=900

# ----- Output -----
OUTPUT_DIR=./data             # where CSV/JSON outputs are written

# ----- Logging -----
# LOG_LEVEL=info              # debug | info | warn | error
