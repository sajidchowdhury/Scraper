# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Output data (keep the directory, ignore its contents)
data/*
!data/.gitkeep

# Logs (keep the directory, ignore its contents)
logs/*
!logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Other generated artifacts
output/
downloads/
screenshots/
videos/
traces/

# Playwright
playwright-report/
test-results/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
